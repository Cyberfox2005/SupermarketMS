<Page x:Class="SupermarketMS.Views.Employees.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Employees" Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Employees &amp; Roles" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <TextBox Margin="Auto,0,0,0" Width="200"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
            <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full Name"  Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role"       Binding="{Binding Role}"     Width="110"/>
                    <DataGridTextColumn Header="Email"      Binding="{Binding Email}"    Width="160"/>
                    <DataGridTextColumn Header="Phone"      Binding="{Binding Phone}"    Width="110"/>
                    <DataGridTextColumn Header="Hire Date"  Binding="{Binding HireDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Salary"     Binding="{Binding Salary, StringFormat=C}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Employee Details" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                <TextBlock Text="FULL NAME *" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>
                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="HIRE DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding HireDate}"/>
                <TextBlock Text="SALARY" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Clear" Style="{StaticResource PrimaryButton}"
                            Background="#8EA9C8" Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                    <Button Content="💾 Save" Style="{StaticResource AccentButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Page>
