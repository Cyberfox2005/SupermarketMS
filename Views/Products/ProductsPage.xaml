<Page x:Class="SupermarketMS.Views.Products.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Products" Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,0,0,16" VerticalAlignment="Center">
            <TextBlock Text="Products &amp; Inventory" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <Border Background="#EBF3FB" CornerRadius="12" Padding="10,4" Margin="12,0,0,0">
                <TextBlock x:Name="TxtCount" Text="0 items" FontSize="12"
                           Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
            </Border>
            <TextBox x:Name="TxtSearch" Width="220" Margin="Auto,0,0,0"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search products…">
            </TextBox>
        </StackPanel>

        <!-- Products Table -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
            <DataGrid x:Name="ProductGrid"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode"   Binding="{Binding Barcode}"      Width="110"/>
                    <DataGridTextColumn Header="Name"      Binding="{Binding Name}"         Width="*"/>
                    <DataGridTextColumn Header="Category"  Binding="{Binding CategoryName}" Width="110"/>
                    <DataGridTextColumn Header="Buy Price" Binding="{Binding PurchasePrice, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Sale Price"Binding="{Binding SalePrice, StringFormat=C}"     Width="90"/>
                    <DataGridTextColumn Header="Stock"     Binding="{Binding Stock}"        Width="70"/>
                    <DataGridTextColumn Header="Unit"      Binding="{Binding Unit}"         Width="60"/>
                    <DataGridTemplateColumn Header="Status" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F8EE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FDECEA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Text" Value="LOW"/>
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Form Panel -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Product Details" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                    <TextBlock Text="BARCODE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="PRODUCT NAME *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding CategoryId}"/>

                    <TextBlock Text="SUPPLIER" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedValuePath="Id" DisplayMemberPath="Name"
                              SelectedValue="{Binding SupplierId}"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PURCHASE PRICE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SALE PRICE" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STOCK QTY" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MIN STOCK" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="UNIT" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EXPIRY DATE" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding ExpiryDate}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button Content="Clear" Style="{StaticResource PrimaryButton}"
                                Background="#8EA9C8"
                                Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                        <Button Content="💾  Save" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</Page>
