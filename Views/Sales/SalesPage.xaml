<Page x:Class="SupermarketMS.Views.Sales.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Point of Sale" Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Cart + Barcode -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Point of Sale" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

            <!-- Barcode scanner row -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SCAN BARCODE / SEARCH PRODUCT" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="TxtBarcode" FontSize="15"
                                 KeyDown="TxtBarcode_KeyDown"/>
                        <Button Grid.Column="1" Content="➕ Add" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddToCartCommand}"/>
                        <Button Grid.Column="2" Content="🗑 Clear Cart" Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding ClearCartCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Cart -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Cart Items" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" IsReadOnly="False"
                              CanUserDeleteRows="False" AutoGenerateColumns="False" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product"   Binding="{Binding ProductName}" Width="*"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Price"     Binding="{Binding UnitPrice, StringFormat=C}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty"       Binding="{Binding Quantity}"    Width="60"/>
                            <DataGridTextColumn Header="Subtotal"  Binding="{Binding Subtotal, StringFormat=C}"  Width="90" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                                                Cursor="Hand"
                                                CommandParameter="{Binding}"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=DataContext.RemoveItemCommand}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

        <!-- RIGHT: Payment summary -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Totals -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,38,0,12">
                <StackPanel>
                    <TextBlock Text="ORDER SUMMARY" Style="{StaticResource FieldLabel}"/>

                    <Grid Margin="0,8,0,4">
                        <TextBlock Text="Subtotal" HorizontalAlignment="Left"  FontSize="13"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat=C}" HorizontalAlignment="Right" FontSize="13"/>
                    </Grid>

                    <TextBlock Text="DISCOUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"/>

                    <Separator Margin="0,12"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="NET TOTAL" HorizontalAlignment="Left" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{Binding NetTotal, StringFormat=C}" HorizontalAlignment="Right"
                                   FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>

                    <TextBlock Text="CASHIER" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Employees}"
                              SelectedValuePath="Id" DisplayMemberPath="FullName"
                              SelectedValue="{Binding EmployeeId}"/>

                    <TextBlock Text="PAYMENT METHOD" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedItem="{Binding PaymentMethod}">
                        <ComboBoxItem>Cash</ComboBoxItem>
                        <ComboBoxItem>Card</ComboBoxItem>
                        <ComboBoxItem>Mobile Payment</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="AMOUNT RECEIVED" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="Bold"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="Change" HorizontalAlignment="Left" FontSize="14"/>
                        <TextBlock Text="{Binding Change, StringFormat=C}" HorizontalAlignment="Right"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Grid.Row="2" Content="✅  Complete Sale" Style="{StaticResource AccentButton}"
                    Height="50" FontSize="16" Command="{Binding CompleteSaleCommand}"/>
        </Grid>

    </Grid>
</Page>
